# Copy this file to .env.local and fill it in
#   cp .env.example .env.local
# ...or just run `python examples/00_setup_database.py` — it creates .env.local for you automatically.

# --- SQL database (created with engine "sqlite") ---
# Needed by: 01, 02, 04, 05, 06
NXDB_ID=nxdb-xxxxxxxxxxxx
NXDB_PASSWORD=your-database-password

# --- NoSQL database (created with engine "nosql") ---
# Needed by: 03, and the last check of 05
NXDB_NOSQL_ID=nxdb-xxxxxxxxxxxx
NXDB_NOSQL_PASSWORD=your-nosql-database-password

# --- Optional overrides ---
# Alternative to password (scoped token, nxdb_...):
# NXDB_TOKEN=nxdb_your_scoped_token
# Embedded apps (origin-restricted):
# NXDB_APP_ID=nxdbapp-xxxx
# NXDB_APP_TOKEN=nxdbapp_xxxx
# Self-hosted gateway:
# NX_API_BASE=https://nxmirror.netlify.app

# --- Written by examples/00_setup_database.py (used by its --cleanup step) ---
# NX_SESSION=nxm_session_token
# NX_ACCOUNT=dbpy12345678
# NX_ACCOUNT_PASSWORD=generated-password
